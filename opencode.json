{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.80",
        "--isolated",
        "--output-dir",
        ".artifacts/playwright"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "playwright_*": "deny"
  },
  "watcher": {
    "ignore": [".artifacts/**"]
  }
}
