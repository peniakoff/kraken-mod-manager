{
  "name": "@kraken/backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json && node scripts/build-backend.mjs && node scripts/copy-frontend.mjs",
    "lint": "oxlint --deny-warnings src test scripts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/server.cjs",
    "package:sea": "node scripts/build-sea.mjs",
    "smoke:sea": "node scripts/smoke-sea.mjs"
  },
  "dependencies": {
    "@kraken/contracts": "workspace:*",
    "@kraken/core": "workspace:*",
    "express": "^5.0.0",
    "express-rate-limit": "8.6.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^26.5.1",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "vitest": "^5.0.0"
  }
}
